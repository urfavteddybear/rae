# --- PostgreSQL ---
DATABASE_URL=postgresql://rae:changeme@localhost:5432/rae
POSTGRES_USER=rae
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rae

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Auth ---
BETTER_AUTH_SECRET=changeme-generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Bot control plane (private) ---
# API -> Bot internal auth. Random long string, never exposed publicly.
RAE_BOT_INTERNAL_SECRET=changeme-generate-with-openssl-rand-hex-32
BOT_CONTROL_PORT=4550
# Internal URL the API uses to reach the bot (compose service name works inside docker net)
BOT_INTERNAL_URL=http://bot:4550

# --- Lavalink (local OR remote, no code change needed) ---
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# --- Web ---
# Server-side API base used by Next.js server components.
# Local dev default: http://localhost:4000 (compose sets http://api:4000).
API_URL=http://localhost:4000
# Public API base for future client components (Phase 3+).
NEXT_PUBLIC_API_URL=http://localhost:4000
